# generated catalog data — the files CI needs are committed
# (catalog.ssr.json, buckets.json, ranks.json, related.json) so a fresh
# checkout builds without re-syncing; the remaining heavy intermediates
# are reproducible via `npm run sync` and stay out of git.
data/raw/
data/snapshots/
data/npm-cache/
data/i18n-cache/
data/awesome-plugins.json
data/dshget-catalog.json
data/catalog-v2.json
data/site.json
data/tags.json
data/categories.json
data/owners.json
data/npm-meta.json
data/security.json
