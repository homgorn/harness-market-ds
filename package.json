{
  "name": "harness-market-ds",
  "type": "module",
  "version": "0.1.0",
  "description": "Multilingual SEO-optimized catalog of DeepSeek Harness plugins",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "sync": "node scripts/sync-catalog-v2.mjs && node scripts/enrich-npm.mjs && node scripts/scan-osv.mjs && node scripts/build-site-data.mjs && node scripts/build-ssr-data.mjs",
    "scan": "node scripts/security-scan.mjs",
    "gates": "node scripts/forge/gates.mjs --all",
    "deploy": "wrangler deploy",
    "prebuild": "node scripts/write-locales-config.mjs",
    "build:full": "node scripts/build-all-locales.mjs",
    "index": "node scripts/build-listing-index.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "translate": "node scripts/translate-descriptions.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.0.0",
    "better-sqlite3": "^11.0.0",
    "pagefind": "^1.1.0",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "allowBuilds": {
      "better-sqlite3": true,
      "esbuild": true,
      "sharp": true,
      "workerd": true
    }
  }
}
