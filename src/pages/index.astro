---
import BaseLayout from '../layouts/BaseLayout.astro';
import { plugins, allCategories, slugOf } from '../lib/catalog';

const cats = allCategories();
const list = plugins.slice(0, 24);
---
<BaseLayout title="DSH Harness Plugin Catalog" description="Browse, search and install DeepSeek Harness plugins. Multilingual, security-scanned." locale="en">
  <h1>DeepSeek Harness Plugin Catalog</h1>
  <p>Browse {plugins.length}+ plugins. Filter by category, tag, security status.</p>

  <div style="margin:1rem 0;">
    <input id="search" type="search" placeholder="Search plugins..." style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--fg);" />
    <div id="results" style="margin-top:1rem;"></div>
  </div>

  <h2>Categories</h2>
  <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
    {cats.map((c) => (
      <a href={`/category/${c.slug}`} style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:.75rem;display:block;">
        <strong>{c.title?.en || c.slug}</strong>
      </a>
    ))}
  </div>

  <h2>Latest</h2>
  <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
    {list.map((p) => (
      <article style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1rem;">
        <h3><a href={`/p/${slugOf(p)}`}>{p.title?.en || p.name}</a></h3>
        <p style="color:var(--muted);font-size:.9rem;">{(p.description?.en || '').slice(0, 120)}</p>
        <div style="font-size:.8rem;margin-top:.5rem;">{p.metadata?.category} · {p.versions?.[0]?.version}</div>
      </article>
    ))}
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new PagefindUI({ element: '#results', showSubResults: true });
      }
    });
  </script>
</BaseLayout>
