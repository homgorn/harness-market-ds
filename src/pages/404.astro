---
import { html, t, catTitle, prefix } from '../lib/ui.js';
import { categoryFacets } from '../lib/catalog.js';

export const prerender = true;

const cats = categoryFacets('en', catTitle);
const body = `<h1>404 — Page not found</h1>
<p class="lead">The page you are looking for does not exist or has moved.</p>
<div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
  <a class="card" href="/"><span class="t">Browse all plugins</span></a>
  <a class="card" href="/category/"><span class="t">All categories</span></a>
  <a class="card" href="/type/"><span class="t">Artifact types</span></a>
  <a class="card" href="/tags/"><span class="t">All tags</span></a>
  <a class="card" href="/security/"><span class="t">Security report</span></a>
  <a class="card" href="/search/"><span class="t">Search</span></a>
</div>
<h2>Popular categories</h2>
<div class="meta">
  ${cats.slice(0, 14).map((c) => `<a class="pill" href="/category/${c.slug}/">${c.title}</a>`).join('')}
</div>`;

const markup = html({
  locale: 'en',
  title: '404 — Page not found | DSH Harness Catalog',
  description: 'The requested page does not exist in the DSH Harness plugin and ecosystem catalog.',
  path: '/404/',
  body,
  categories: cats,
  tags: [],
});
---
{markup}
