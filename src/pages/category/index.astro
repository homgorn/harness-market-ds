---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allCategories, pluginsByCategory } from '../../lib/catalog';

const cats = allCategories();
---
<BaseLayout title="Categories" description="Browse plugins by category.">
  <h1>Categories</h1>
  <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
    {cats.map((c) => (
      <a href={`/category/${c.slug}`} style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1rem;display:block;">
        <h3>{c.title?.en || c.slug}</h3>
        <p style="color:var(--muted);font-size:.9rem;">{pluginsByCategory(c.slug).length} plugins</p>
      </a>
    ))}
  </div>
</BaseLayout>
